# DeepSeek OCR 服务配置
# 请根据你的实际情况修改以下配置

# 模型路径（必需）
MODEL_PATH=./model/DeepSeek-OCR

# GPU 配置
GPU_ID=0

# 服务端口
PORT=8707

# CPU 工作线程数
CPU_WORKERS=2

# Conda 环境配置
# 方式1: 使用 conda 环境名称（需要 conda 命令）
#CONDA_ENV_NAME=dso

# 方式2: 直接使用 miniconda 环境路径（推荐用于 miniconda）
PYTHON_PATH=python

# PYTHON 版本（仅在使用 conda 环境名称时需要）
PYTHON_VERSION=3.10

# 服务配置
HOST=0.0.0.0